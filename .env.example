# ── Proveedor de IA ──
LLM_PROVIDER=anthropic          # anthropic | workers_ai (cuota gratis diaria) | ollama ($0, corre en tu equipo)
ANTHROPIC_API_KEY=
ANTHROPIC_CONTENT_MODEL=claude-haiku-5-5
ANTHROPIC_RESPONSE_MODEL=claude-haiku-5-5

# ── Control de costos ──
FREE_REPLIES_ENABLED=true
KB_MATCH_THRESHOLD=0.6
MAX_HISTORY_MESSAGES=4
MAX_REPLY_TOKENS=350

# ── Meta ──
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=cambia_esto
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Negocio ──
BUSINESS_NAME=Felix Software
BUSINESS_ROLE=un estudio de desarrollo de software a la medida con rentas mensuales accesibles
BUSINESS_DESCRIPTION=Software a la medida (CaaS) con renta mensual accesible. Asesoría gratuita para conocer tu idea.
BOOKING_URL=
KB_SEED_FILE=data/kb_felix_software.json

# ── Cloudflare Workers AI (LLM_PROVIDER=workers_ai) ──
CF_ACCOUNT_ID=
CF_API_TOKEN=                    # token de API con permiso "Workers AI"
CF_RESPONSE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
CF_CONTENT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
CF_EMBEDDING_MODEL=@cf/baai/bge-m3

# ── RAG ──
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_ENTRIES=6
RAG_EMBEDDINGS=false             # true = búsqueda semántica (gasta unas pocas neuronas)
